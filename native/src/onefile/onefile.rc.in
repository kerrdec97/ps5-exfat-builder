#include <winver.h>

// Icon 1 is the file icon Explorer shows and the progress window's icon.
1 ICON "@FW_APP_ICON@"
1 24 "@CMAKE_CURRENT_BINARY_DIR@/onefile.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kerrdec97"
            VALUE "FileDescription", "PS5 exFAT Image Builder - Farewell Edition"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "exFAT Image Builder (single-file launcher)"
            VALUE "LegalCopyright", "Copyright (c) 2026 Deckerr97 (kerrdec97). All rights reserved. See LICENCE.txt and THIRD_PARTY_NOTICES.md."
            VALUE "OriginalFilename", "exFAT Image Builder.exe"
            VALUE "ProductName", "exFAT Image Builder - Farewell Edition"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
