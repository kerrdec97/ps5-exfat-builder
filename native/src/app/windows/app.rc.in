#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/windows/app.ico"
1 24 "@CMAKE_CURRENT_BINARY_DIR@/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kerrdec97"
            VALUE "FileDescription", "exFAT Image Builder"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "exFAT Image Builder"
            VALUE "LegalCopyright", "Copyright (c) 2026 Deckerr97 (kerrdec97). All rights reserved. See LICENCE.txt and THIRD_PARTY_NOTICES.md."
            VALUE "OriginalFilename", "exFAT Image Builder.exe"
            VALUE "ProductName", "exFAT Image Builder"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
